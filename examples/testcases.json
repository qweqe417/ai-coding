{
  "testcases": [
    {
      "id": "TC001",
      "name": "创建用户",
      "test_type": "backend",
      "description": "测试创建用户API，验证MySQL和Redis数据",
      "api": {
        "method": "POST",
        "url": "/api/users",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "username": "testuser",
          "email": "test@example.com",
          "age": 25
        }
      },
      "expected_http": {
        "status_code": 200,
        "body": {
          "code": 0,
          "message": "success"
        }
      }
    },
    {
